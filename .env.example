# Milobiwan Studio Environment Variables
# Stel de gewenste 4-cijferige pincode in via het hosting platform (bijv. Netlify Environment Variables)
STUDIO_PIN=jouw_geheime_pincode_hier

# Google Gemini API Key (voor poëtische titelsuggesties via AI)
# Haal gratis op via https://aistudio.google.com/
GEMINI_API_KEY=jouw_gemini_api_key_hier

# Optioneel specifiek model (bijv. gemini-2.5-flash, gemini-3-flash of gemini-3.7-flash)
GEMINI_MODEL=gemini-2.5-flash


